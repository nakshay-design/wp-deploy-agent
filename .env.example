# Shared secret required by the web UI / API before it will deploy anything.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DEPLOY_ACCESS_TOKEN=replace-with-a-long-random-string

# Optional: FTP password for the CLI (preferred over putting it in config.json).
# The config uses "passwordEnv": "LM_FTP_PASS".
# LM_FTP_PASS=
